{
    "name": "mykiwi/castor-extended",
    "description": "Makefile logic for Castor",
    "keywords": ["castor", "task-runner", "Makefile"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Romain Gautier",
            "email": "mykiwi@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/finder": "^6.4 || ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "jolicode/castor": "^1.5,<1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "symfony/filesystem": "^6.4 || ^7.0"
    },
    "autoload": {
        "files": [
            "src/make.php"
        ],
        "psr-4": {
            "Mykiwi\\CastorExtended\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mykiwi\\CastorExtended\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
